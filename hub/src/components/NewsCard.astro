---
import type { WireArticle } from '../lib/wire'
interface Props { article: WireArticle }
const { article } = Astro.props
const date = article.published ? new Date(article.published) : null
const siteLabel = article.originSite.replace(/-/g, '.')
---
<a
  href={`/news/${article.id.replace(/^urn:ribose:news:/, '').replace(/:/g, '-')}`}
  class="card group flex flex-col p-5"
>
  <div class="flex items-center gap-2 text-xs text-slate-500 dark:text-slate-500">
    <time datetime={article.published ?? undefined}>{date ? date.toISOString().slice(0, 10) : ''}</time>
    <span aria-hidden="true">·</span>
    <span>{siteLabel}</span>
  </div>
  <h3 class="mt-2.5 font-semibold text-lg leading-snug group-hover:text-brand-700 dark:group-hover:text-brand-300">{article.headline}</h3>
  <span class="mt-4 text-sm font-medium text-brand-700 no-underline group-hover:underline dark:text-brand-400">Read <span class="read-arrow" aria-hidden="true">→</span></span>
</a>
