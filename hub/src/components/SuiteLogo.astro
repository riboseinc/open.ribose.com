---
import { logoFor, logoDarkFor, suiteLogoClass } from '../lib/logos'
interface Props { suite: { id: string; name: string }; imgClass?: string }
const { suite, imgClass = '' } = Astro.props
const light = logoFor(suite.id)
const dark = logoDarkFor(suite.id)
const cls = suiteLogoClass(suite.id)
---
{light ? (
  dark ? (
    <>
      <img src={light} alt="" class={`dark:hidden ${imgClass}`} loading="lazy" />
      <img src={dark} alt="" class={`hidden dark:block ${imgClass}`} loading="lazy" />
    </>
  ) : (
    <img src={light} alt="" class={`${cls} ${imgClass}`} loading="lazy" />
  )
) : (
  <span class:list={['logo-tile', imgClass]}>{suite.name.slice(0, 1)}</span>
)}
