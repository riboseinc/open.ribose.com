---
import { platformLogoFor } from '../lib/logos'
interface Props { platformId: string; variant?: 'symbol' | 'logo'; imgClass?: string }
const { platformId, variant = 'symbol', imgClass = '' } = Astro.props
const pair = platformLogoFor(platformId, variant)
---
{pair && (
  pair.dark ? (
    <>
      <img src={pair.light} alt="" class={`dark:hidden ${imgClass}`} />
      <img src={pair.dark} alt="" class={`hidden dark:block ${imgClass}`} />
    </>
  ) : (
    <img src={pair.light} alt="" class={imgClass} />
  )
)}
