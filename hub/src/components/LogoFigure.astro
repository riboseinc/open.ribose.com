---
import { treatmentFor } from '../lib/logoTreatment'
interface Props {
  logo: string
  logoDark?: string
  name: string
  imgClass?: string
}
const { logo, logoDark, name, imgClass = '' } = Astro.props
const t = treatmentFor(logo)
---
{logoDark ? (
  <>
    <img src={`/logos/${logo}`} alt={name} class={`dark:hidden ${imgClass}`} loading="lazy" />
    <img src={`/logos/${logoDark}`} alt={name} class={`hidden dark:block ${imgClass}`} loading="lazy" />
  </>
) : t.lightInk ? (
  <span class="inline-grid place-items-center rounded-md bg-ink p-1.5 dark:bg-transparent dark:p-0">
    <img src={`/logos/${logo}`} alt={name} class={imgClass} loading="lazy" />
  </span>
) : (
  <img src={`/logos/${logo}`} alt={name} class={imgClass} loading="lazy" />
)}
