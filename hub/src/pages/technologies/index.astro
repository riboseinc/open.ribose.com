---
import BaseLayout from '../../layouts/Base.astro'
import TechnologyDirectory from '../../components/islands/TechnologyDirectory.vue'
import { suites, domains, domainById } from '../../lib/registry'
import { logoFor, logoDarkFor, suiteLogoClass } from '../../lib/logos'

const entries = suites.map((suite) => ({
  id: suite.id, name: suite.name, tagline: suite.tagline,
  domain: suite.domain, domainName: domainById(suite.domain)?.name ?? suite.domain,
  logo: logoFor(suite.id), logoDark: logoDarkFor(suite.id), logoClass: suiteLogoClass(suite.id),
  org: suite.org, softwares: suite.softwares.length,
}))
const domainOptions = domains.map((d) => ({ id: d.id, name: d.name }))
---
<BaseLayout title="Technologies" description="All Ribose open-source suites: standards, modelling, language, fonts, data, graphics, infrastructure, security." path="/technologies">
  <section class="mx-auto max-w-6xl px-4 py-16 sm:px-6">
    <p class="eyebrow">Portfolio</p>
    <h1 class="h-display mt-2 text-4xl font-bold sm:text-5xl">Technologies</h1>
    <p class="mt-4 max-w-2xl text-slate-600 dark:text-slate-400">Every suite, every domain. {suites.length} suites of open-source software, each with its own organization and community.</p>
    <div class="mt-8">
      <TechnologyDirectory client:visible suites={entries} domains={domainOptions} />
    </div>
  </section>
</BaseLayout>
