---
import BaseLayout from '../../layouts/Base.astro'
import { wire, type WireArticle } from '../../lib/wire'
import { newsArticleJsonLd } from '../../lib/seo'
import { t } from '../../lib/i18n'

// Wire articles are emitted by [...slug].astro (which also handles migrated
// posts); returning [] here keeps /news/* generated from a single template.
export function getStaticPaths() {
  return []
}

function unusedPaths() {
  const reader = wire()
  return reader.index().map((article) => ({
    params: { id: article.id.replace(/^urn:ribose:news:/, '').replace(/:/g, '/') },
    props: { article },
  }))
}

const { article } = Astro.props as { article: WireArticle }
const full = wire().article(article)
const Asciidoctor = (await import('asciidoctor')).default
const asciidoctor = Asciidoctor()
const bodyHtml = asciidoctor.convert(full.bodyAdoc, { safe: 'safe' }) as string

const date = full.published ? new Date(full.published) : null
const jsonLd = [newsArticleJsonLd(full)]
---
<BaseLayout title={full.headline} description={full.subheadline ?? full.headline} path={`/news/${article.id.replace(/^urn:ribose:news:/, '').replace(/:/g, '/')}`} type="article" publishedTime={full.published ?? undefined} jsonLd={jsonLd} canonicalHref={article.canonical}>
  <article class="mx-auto max-w-3xl px-4 py-12 sm:px-6">
    <nav class="text-sm text-slate-500 dark:text-slate-400" aria-label="Breadcrumb"><a href="/news">News</a></nav>
    {date && <time class="mt-6 block text-sm text-slate-500 dark:text-slate-400" datetime={full.published ?? undefined}>{date.toISOString().slice(0, 10)}</time>}
    <h1 class="mt-2 text-3xl font-bold sm:text-4xl">{full.headline}</h1>
    {full.subheadline && <p class="mt-3 text-lg text-slate-600 dark:text-slate-400">{full.subheadline}</p>}
    {full.media.length > 0 && (
      <figure class="mt-8">
        <img src={full.media[0].href} alt={full.media[0].alt ?? ''} width="960" height="540" class="w-full rounded-2xl border border-slate-200 dark:border-slate-800" loading="eager" />
        {full.media[0].credit && <figcaption class="mt-2 text-xs text-slate-500 dark:text-slate-400">{full.media[0].credit}</figcaption>}
      </figure>
    )}
    <div class="prose-news mt-8" set:html={bodyHtml} />
    <footer class="mt-10 rounded-2xl border border-brand-200 bg-brand-50 p-5 text-sm dark:border-slate-700 dark:bg-ink-2">
      <p>{t('news.origin')} <a href={article.canonical} rel="canonical" class="font-semibold">{article.originSite.replace(/-/g, '.')}</a> · license {'{'}CC-BY-4.0{'}'}</p>
      {full.authors.length > 0 && <p class="mt-1 text-slate-600 dark:text-slate-400">By {full.authors.map((a) => a.name).join(', ')}</p>}
    </footer>
  </article>
</BaseLayout>
